[Desktop Entry]
Name=Tempera
GenericName=Paint
Comment=Draw and edit raster images
Exec=tempera %f
Icon=io.github.rafael0rueda.Tempera
Terminal=false
Type=Application
Categories=Graphics;2DGraphics;RasterGraphics;GTK;
MimeType=image/png;image/jpeg;image/bmp;image/tiff;image/webp;
Keywords=paint;draw;image;editor;bitmap;sketch;
StartupNotify=true
